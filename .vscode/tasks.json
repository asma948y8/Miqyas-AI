{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Miqyas AI Flask",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-c",
                "import sys; sys.path.insert(0, r'${workspaceFolder}\\Miqyas-AI'); import app; app.app.run(host='127.0.0.1', port=5002, debug=False)"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": [],
            "group": "build"
        }
    ]
}
